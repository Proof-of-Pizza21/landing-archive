    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.3",
    "lucide-react": "1.41.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "single-file-core": "1.5.121"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "26.4.1",
    "@types/pngjs": "6.0.5",
